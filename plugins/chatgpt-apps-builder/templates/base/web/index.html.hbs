<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{titleCase appName}} - Widget Dev Preview</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bg);
      color: var(--fg);
      min-height: 100vh;
      transition: background 0.3s, color 0.3s;
    }

    :root {
      --bg: #ffffff;
      --fg: #1a1a1a;
      --border: #e5e5e5;
      --muted: #6b7280;
      --primary: #2563eb;
    }

    .dark {
      --bg: #1a1a1a;
      --fg: #fafafa;
      --border: #333333;
      --muted: #9ca3af;
      --primary: #3b82f6;
    }

    /* Dev Toolbar */
    .dev-toolbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 20px;
      z-index: 1000;
    }

    .dev-toolbar h1 {
      font-size: 14px;
      font-weight: 600;
      color: var(--primary);
    }

    .dev-toolbar select,
    .dev-toolbar button {
      padding: 6px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg);
      color: var(--fg);
      font-size: 13px;
      cursor: pointer;
    }

    .dev-toolbar button:hover {
      background: var(--border);
    }

    .dev-toolbar .spacer {
      flex: 1;
    }

    .dev-toolbar label {
      font-size: 12px;
      color: var(--muted);
    }

    /* Widget Container */
    .widget-frame {
      margin-top: 60px;
      padding: 20px;
      display: flex;
      justify-content: center;
    }

    .widget-container {
      width: 100%;
      max-width: 800px;
      border: 1px solid var(--border);
      border-radius: 12px;
      overflow: hidden;
      background: var(--bg);
    }

    .widget-container.fullscreen {
      position: fixed;
      top: 60px;
      left: 0;
      right: 0;
      bottom: 0;
      max-width: none;
      border-radius: 0;
      border: none;
    }

    #widget-root {
      min-height: 300px;
    }

    /* Mock Data Panel */
    .mock-panel {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: var(--bg);
      border-top: 1px solid var(--border);
      max-height: 300px;
      overflow: auto;
      display: none;
    }

    .mock-panel.open {
      display: block;
    }

    .mock-panel-header {
      padding: 10px 20px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .mock-panel-header h3 {
      font-size: 13px;
      font-weight: 600;
    }

    .mock-panel textarea {
      width: 100%;
      min-height: 150px;
      padding: 15px 20px;
      border: none;
      background: transparent;
      color: var(--fg);
      font-family: 'SF Mono', Consolas, monospace;
      font-size: 12px;
      resize: vertical;
    }

    .mock-panel textarea:focus {
      outline: none;
    }

    /* Status Bar */
    .status-bar {
      position: fixed;
      bottom: 0;
      right: 20px;
      padding: 8px 16px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-bottom: none;
      border-radius: 8px 8px 0 0;
      font-size: 11px;
      color: var(--muted);
    }

    .status-bar.mock-open {
      bottom: 300px;
    }
  </style>
</head>
<body>
  <!-- Dev Toolbar -->
  <div class="dev-toolbar">
    <h1>{{titleCase appName}} Dev</h1>

    <label>Widget:</label>
    <select id="widget-select">
      <option value="">Select a widget...</option>
      {{#each widgets}}
      <option value="{{kebabCase this.name}}">{{titleCase this.name}}</option>
      {{/each}}
    </select>

    <label>Display:</label>
    <select id="display-mode">
      <option value="inline">Inline</option>
      <option value="fullscreen">Fullscreen</option>
    </select>

    <div class="spacer"></div>

    <button id="theme-toggle">Toggle Dark Mode</button>
    <button id="mock-toggle">Mock Data</button>
    <button id="reload-btn">Reload</button>
  </div>

  <!-- Widget Frame -->
  <div class="widget-frame">
    <div class="widget-container" id="widget-container">
      <div id="widget-root">
        <div style="padding: 40px; text-align: center; color: var(--muted);">
          Select a widget from the dropdown above
        </div>
      </div>
    </div>
  </div>

  <!-- Mock Data Panel -->
  <div class="mock-panel" id="mock-panel">
    <div class="mock-panel-header">
      <h3>Mock Tool Output (JSON)</h3>
      <button id="apply-mock">Apply</button>
    </div>
    <textarea id="mock-data" placeholder='{"items": [], "title": "Example"}'></textarea>
  </div>

  <!-- Status Bar -->
  <div class="status-bar" id="status-bar">
    Ready
  </div>

  <!-- Mock OpenAI API -->
  <script type="module" src="/src/dev/mock-openai.ts"></script>

  <!-- Widget Loader -->
  <script type="module">
    const widgetSelect = document.getElementById('widget-select');
    const displayMode = document.getElementById('display-mode');
    const themeToggle = document.getElementById('theme-toggle');
    const mockToggle = document.getElementById('mock-toggle');
    const reloadBtn = document.getElementById('reload-btn');
    const mockPanel = document.getElementById('mock-panel');
    const mockData = document.getElementById('mock-data');
    const applyMock = document.getElementById('apply-mock');
    const widgetContainer = document.getElementById('widget-container');
    const widgetRoot = document.getElementById('widget-root');
    const statusBar = document.getElementById('status-bar');

    let currentWidget = null;

    // Theme toggle
    themeToggle.addEventListener('click', () => {
      document.documentElement.classList.toggle('dark');
      window.__OPENAI_MOCK__.theme = document.documentElement.classList.contains('dark') ? 'dark' : 'light';
      statusBar.textContent = `Theme: ${window.__OPENAI_MOCK__.theme}`;
    });

    // Display mode
    displayMode.addEventListener('change', () => {
      if (displayMode.value === 'fullscreen') {
        widgetContainer.classList.add('fullscreen');
      } else {
        widgetContainer.classList.remove('fullscreen');
      }
    });

    // Mock panel toggle
    mockToggle.addEventListener('click', () => {
      mockPanel.classList.toggle('open');
      statusBar.classList.toggle('mock-open');
    });

    // Apply mock data
    applyMock.addEventListener('click', () => {
      try {
        const data = JSON.parse(mockData.value);
        window.__OPENAI_MOCK__.toolOutput = data;
        statusBar.textContent = 'Mock data applied - reload widget to see changes';
      } catch (e) {
        statusBar.textContent = 'Error: Invalid JSON';
      }
    });

    // Widget loader
    async function loadWidget(name) {
      if (!name) {
        widgetRoot.innerHTML = '<div style="padding: 40px; text-align: center; color: var(--muted);">Select a widget from the dropdown above</div>';
        return;
      }

      statusBar.textContent = `Loading ${name}...`;
      widgetRoot.innerHTML = '<div style="padding: 40px; text-align: center;">Loading...</div>';

      try {
        // Clear previous widget
        widgetRoot.innerHTML = `<div id="${name}-root"></div>`;

        // Dynamic import
        await import(`/src/widgets/${name}.tsx`);

        statusBar.textContent = `Loaded: ${name}`;
        currentWidget = name;
      } catch (e) {
        widgetRoot.innerHTML = `<div style="padding: 40px; text-align: center; color: #ef4444;">Error loading widget: ${e.message}</div>`;
        statusBar.textContent = `Error: ${e.message}`;
        console.error(e);
      }
    }

    widgetSelect.addEventListener('change', () => {
      loadWidget(widgetSelect.value);
    });

    reloadBtn.addEventListener('click', () => {
      if (currentWidget) {
        loadWidget(currentWidget);
      }
    });

    // Initialize
    if (window.location.hash) {
      const widget = window.location.hash.slice(1);
      widgetSelect.value = widget;
      loadWidget(widget);
    }
  </script>
</body>
</html>
