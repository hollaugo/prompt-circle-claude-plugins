#!/bin/bash
#
# {{appName}} - Setup Script (Pattern A)
#
# This script:
# - Checks prerequisites (Node.js 18+)
# - Installs npm dependencies
# - Builds the server
# - Creates .env file with required configuration
#
# Usage:
#   ./setup.sh
#
set -euo pipefail

cd "$(dirname "$0")"

echo ""
echo "============================================================"
echo "  {{appName}} - Setup"
echo "============================================================"
echo ""

# =============================================================================
# Prerequisites Check
# =============================================================================

echo "Checking prerequisites..."

if ! command -v node >/dev/null 2>&1; then
  echo "  [ERROR] Node.js not found. Please install Node.js 18+ first."
  echo "          https://nodejs.org/"
  exit 1
fi

NODE_VERSION=$(node -v | cut -d'v' -f2 | cut -d'.' -f1)
if [ "$NODE_VERSION" -lt 18 ]; then
  echo "  [ERROR] Node.js 18+ required. Current version: $(node -v)"
  exit 1
fi
echo "  [OK] Node.js $(node -v)"

if ! command -v npm >/dev/null 2>&1; then
  echo "  [ERROR] npm not found. Please install npm first."
  exit 1
fi
echo "  [OK] npm $(npm -v)"

echo ""

# =============================================================================
# Install Dependencies
# =============================================================================

echo "Installing dependencies..."
npm install
echo "  [OK] Dependencies installed"
echo ""

# =============================================================================
# Build Server
# =============================================================================

echo "Building server..."
npm run build:server
echo "  [OK] Server built to dist/server/"
echo ""

# =============================================================================
# Create .env File
# =============================================================================

echo "Configuring environment..."

if [ -f .env ]; then
  echo "  .env already exists."
  read -p "  Overwrite? (y/N) " -n 1 -r
  echo
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "  [OK] Keeping existing .env"
    CREATE_ENV=false
  else
    CREATE_ENV=true
  fi
else
  CREATE_ENV=true
fi

if [ "$CREATE_ENV" = true ]; then
  cat > .env << 'EOF'
# {{appName}} - Environment Variables
# Generated by setup.sh
#
# The server loads these automatically via dotenv.
# For local overrides, create .env.local (gitignored)

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3000
HTTP_MODE=true
NODE_ENV=development
WIDGET_DOMAIN=http://localhost:3000

{{#if database}}
# =============================================================================
# Database Configuration (Supabase)
# =============================================================================
# Local development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Production (uncomment and fill in)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-production-service-key
{{/if}}

{{#if auth.auth0}}
# =============================================================================
# Auth0 Configuration
# =============================================================================
# AUTH0_DOMAIN=your-tenant.auth0.com
# AUTH0_CLIENT_ID=your-client-id
# AUTH0_CLIENT_SECRET=your-client-secret
{{/if}}

{{#each externalApis}}
# =============================================================================
# {{name}} Configuration
# =============================================================================
{{#each envVars}}
# {{this}}=
{{/each}}

{{/each}}
EOF
  echo "  [OK] .env file created"
fi

# =============================================================================
# Create .env.local.example
# =============================================================================

if [ ! -f .env.local.example ]; then
  cat > .env.local.example << 'EOF'
# Local Development Overrides
# Copy this to .env.local for your personal settings
# .env.local is gitignored and won't be committed

# Example: Override port for local testing
# PORT=3001

# Example: Enable debug logging
# DEBUG=*
EOF
  echo "  [OK] .env.local.example created"
fi

# =============================================================================
# Make Scripts Executable
# =============================================================================

chmod +x START.sh 2>/dev/null || true
echo "  [OK] START.sh is executable"

echo ""

# =============================================================================
# Setup Complete
# =============================================================================

echo "============================================================"
echo "  Setup complete!"
echo "============================================================"
echo ""
echo "  Next steps:"
echo ""
echo "    ./START.sh            Start HTTP server (for ChatGPT)"
echo "    ./START.sh --dev      Dev mode with verbose logging"
echo "    ./START.sh --preview  Preview widgets in browser"
echo ""
echo "  Useful commands:"
echo ""
echo "    npm run dev           Dev mode with hot reload + logs"
echo "    npm run validate      Type-check without building"
echo "    curl localhost:3000/health    Test server health"
echo ""
