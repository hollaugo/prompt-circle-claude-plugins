// Individual widget preview with mock data
app.get("/preview/:widgetId", (req: Request, res: Response) => {
  const widget = WIDGETS_BY_ID.get(req.params.widgetId);
  if (!widget) {
    res.status(404).send(`<h1>Widget not found: ${req.params.widgetId}</h1>`);
    return;
  }

  log(`Previewing widget: ${widget.id} with mock data`);
  const html = generateWidgetHtml(widget.id, widget.mockData);
  res.setHeader("Content-Type", "text/html");
  res.send(html);
});

// MCP endpoint with session management
app.all("/mcp", async (req: Request, res: Response) => {
  log("MCP request:", req.method, req.headers["mcp-session-id"] || "no-session");

  // Check for existing session
  let sessionId = req.headers["mcp-session-id"] as string | undefined;
  let transport = sessionId ? transports.get(sessionId) : undefined;

  // Check if this is an initialize request (new session)
  const isInitialize =
    req.body?.method === "initialize" ||
    (Array.isArray(req.body) && req.body.some((m: JSONRPCMessage) => "method" in m && m.method === "initialize"));

  if (isInitialize || !sessionId || !transport) {
    // Create new session
    sessionId = randomUUID();
    log(`Creating new session: ${sessionId}`);

    transport = new StreamableHTTPServerTransport({
      sessionIdGenerator: () => sessionId!,
      onsessioninitialized: (id) => {
        log(`Session initialized: ${id}`);
      },
    });

    transports.set(sessionId, transport);

    const server = createServer();

    // Clean up on close
    res.on("close", () => {
      log(`Connection closed for session: ${sessionId}`);
    });

    transport.onclose = () => {
      log(`Transport closed for session: ${sessionId}`);
      transports.delete(sessionId!);
      server.close();
    };

    await server.connect(transport);
  }

  // Handle the request
  await transport.handleRequest(req, res, req.body);
});

// Handle DELETE for session cleanup
app.delete("/mcp", async (req: Request, res: Response) => {
  const sessionId = req.headers["mcp-session-id"] as string | undefined;
  log(`DELETE /mcp for session: ${sessionId}`);

  if (sessionId && transports.has(sessionId)) {
    const transport = transports.get(sessionId)!;
    await transport.handleRequest(req, res, req.body);
  } else {
    res.status(404).json({ error: "Session not found" });
  }
});

