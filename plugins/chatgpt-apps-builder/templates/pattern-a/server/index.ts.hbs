// Development logging
function log(...args: unknown[]) {
  if (NODE_ENV === "development") {
    console.log(`[${new Date().toISOString()}]`, ...args);
  }
}

// =============================================================================
// Widget Configuration
// =============================================================================

interface WidgetConfig {
  id: string;
  name: string;
  description: string;
  templateUri: string;
  invoking: string;
  invoked: string;
  mockData: Record<string, unknown>;
}

// Define your widgets here
const widgets: WidgetConfig[] = [
{{#each widgets}}
  {
    id: "{{id}}",
    name: "{{name}}",
    description: "{{description}}",
    templateUri: "ui://widget/{{id}}.html",
    invoking: "{{invoking}}",
    invoked: "{{invoked}}",
    mockData: {{{json mockData}}},
  },
{{/each}}
];

// Create lookup maps
const WIDGETS_BY_ID = new Map(widgets.map((w) => [w.id, w]));
const WIDGETS_BY_URI = new Map(widgets.map((w) => [w.templateUri, w]));

// =============================================================================
// Inline Widget HTML Generator
// =============================================================================

function generateWidgetHtml(widgetId: string, data?: Record<string, unknown>): string {
  const widget = WIDGETS_BY_ID.get(widgetId);
  if (!widget) {
    return `<html><body><h1>Widget not found: ${widgetId}</h1></body></html>`;
  }

  // For preview mode, inject mock data
  const previewScript = data
    ? `<script>window.PREVIEW_DATA = ${JSON.stringify(data)};</script>`
    : "";

  return `<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${widget.name}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      padding: 16px;
      background: var(--bg-color, #ffffff);
      color: var(--text-color, #1a1a1a);
    }
    .loading {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 200px;
      color: #666;
    }
    .error {
      padding: 16px;
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 8px;
      color: #dc2626;
    }
    /* Add widget-specific styles here */
    {{> widgetStyles}}
  </style>
  ${previewScript}
</head>
<body>
  <div id="root">
    <div class="loading">Loading...</div>
  </div>
  <script>
    (function() {
      let rendered = false;

      function render(data) {
        if (rendered) return;
        rendered = true;

        const root = document.getElementById('root');
        if (!data) {
          root.innerHTML = '<div class="error">No data received</div>';
          return;
        }

        try {
          // Widget-specific rendering
          {{> widgetRenderLogic}}
        } catch (err) {
          root.innerHTML = '<div class="error">Render error: ' + err.message + '</div>';
          console.error('Widget render error:', err);
        }
      }

      function tryRender() {
        // Check for preview data first
        if (window.PREVIEW_DATA) {
          render(window.PREVIEW_DATA);
          return;
        }
        // Then check for ChatGPT data
        if (window.openai?.toolOutput) {
          render(window.openai.toolOutput);
        }
      }

      // ChatGPT Apps SDK integration
      window.addEventListener('openai:set_globals', tryRender);

      // Polling fallback for reliability
      const pollInterval = setInterval(() => {
        if (window.openai?.toolOutput || window.PREVIEW_DATA) {
          tryRender();
          clearInterval(pollInterval);
        }
      }, 100);

      // Timeout after 10 seconds
      setTimeout(() => clearInterval(pollInterval), 10000);

      // Try immediately
      tryRender();
    })();
  </script>
</body>
</html>`;
}

